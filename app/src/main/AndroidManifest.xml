<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Nur um vor dem Vorladen der Bilder zu pruefen, ob das Netz WLAN (nicht nach Volumen) ist. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Kamera nur fuer eigene Markenfotos; die App kommt auch ohne aus. -->
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <!-- Alles liegt offen als Dateien beim Menschen; ein Backup der App-Daten ist erwuenscht. -->
    <application
        android:name="de.bgghome.philaphil.PhilaApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.PhilaPhil">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Kamera-Aufnahmen landen in einer eigenen Datei im Cache; die Kamera-App bekommt nur fuer diese Datei Schreibrecht. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
