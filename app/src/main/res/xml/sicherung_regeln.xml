<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 und neuer: Sicherung in die Cloud und Umzug auf ein neues Geraet ohne Geheimnisse. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="geheim.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="geheim.xml" />
    </device-transfer>
</data-extraction-rules>
